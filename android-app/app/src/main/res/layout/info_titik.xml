<?xml version="1.0" encoding="utf-8"?>
<!-- Gelembung info penanda peta: teks di kiri, pipa BioporiPrint berputar mengisi ruang kosong di kanan. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="260dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:background="@drawable/bg_info_titik">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/info_judul"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#0F172A"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/info_isi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#475569"
            android:textSize="13sp" />
    </LinearLayout>

    <id.ecowin.app.PipaPutarView
        android:id="@+id/info_pipa"
        android:layout_width="84dp"
        android:layout_height="112dp"
        android:layout_marginStart="10dp" />
</LinearLayout>
