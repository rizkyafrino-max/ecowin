<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">#059669</item>
        <item name="android:statusBarColor">#F8FAFC</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Splash Screen native Android (API 31+ bawaan sistem, di bawahnya lewat core-splashscreen). -->
    <style name="Theme.EcoWin.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#F8FAFC</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>
</resources>
