<?xml version="1.0" encoding="utf-8"?>
<!-- Ikon splash: logo EcoWin asli. Kanvas 288dp (ukuran ikon tanpa latar pada Android 12+) dengan logo di tengah:
     setengah diagonal logo (±89dp) berada di dalam topeng lingkaran sistem (jari-jari 96dp), jadi tidak terpotong,
     dan ukurannya sama (116dp) dengan layar peluncuran Compose sehingga transisi tanpa lompatan. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="288dp" android:height="288dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <size android:width="288dp" android:height="288dp" />
        </shape>
    </item>
    <item
        android:width="116dp"
        android:height="135dp"
        android:gravity="center"
        android:drawable="@drawable/ecowin_logo" />
</layer-list>
