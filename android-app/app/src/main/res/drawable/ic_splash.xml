<?xml version="1.0" encoding="utf-8"?>
<!-- Ikon splash: logo EcoWin asli. Kanvas 288dp (ukuran ikon tanpa latar pada Android 12+) dengan logo di tengah.
     Bitmap memakai gravity "fill" agar diskalakan penuh ke kotak 116x135dp (sesuai rasio logo), bukan dipotong
     pada ukuran pikselnya. Setengah diagonal logo (±89dp) berada di dalam topeng lingkaran sistem (jari-jari 96dp). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="288dp" android:height="288dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <size android:width="288dp" android:height="288dp" />
        </shape>
    </item>
    <item
        android:width="116dp"
        android:height="135dp"
        android:gravity="center">
        <bitmap
            android:src="@drawable/ecowin_logo"
            android:gravity="fill" />
    </item>
</layer-list>
