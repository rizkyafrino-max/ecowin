APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Google Sign-In (WAJIB, semua role login dengan Google) ---
# Buat OAuth Client "Web application" di Google Cloud Console.
# Authorized redirect URI: ${APP_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
# Client ID tambahan yang boleh menjadi audience ID token (pisahkan koma), opsional.
GOOGLE_EXTRA_CLIENT_IDS=

# Persistent login dashboard (menit) & masa berlaku token Android (menit)
AUTH_REMEMBER_MINUTES=43200
ECOWIN_ACCESS_TOKEN_TTL=1440
ECOWIN_REFRESH_TOKEN_TTL=86400

# Estimasi kompos (berat x rasio) & estimasi panen biopori (hari)
ECOWIN_KOMPOS_RASIO=0.5
ECOWIN_BIOPORI_HARI_PANEN=60

# Akun Google testing untuk seeder (development)
ECOWIN_SEED_ADMIN_EMAIL=
ECOWIN_SEED_PETUGAS_EMAIL=
ECOWIN_SEED_NASABAH_EMAIL=

# React Web Nasabah (origin yang boleh memanggil API, pisahkan koma)
ECOWIN_WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Alamat aplikasi web Nasabah: tujuan serah-terima login Nasabah dari halaman Laravel
ECOWIN_WEB_URL=http://localhost:5173
