# Contoh backend/.env untuk PRODUKSI. Salin ke /var/www/ecowin/backend/.env di server lalu isi nilai bertanda ISI_.
# JANGAN di-commit berkas .env sungguhan; sandi dan secret hanya ada di server.

APP_NAME=EcoWin
APP_ENV=production
# APP_KEY dibiarkan kosong; diisi otomatis oleh skrip rilis (php artisan key:generate --force)
APP_KEY=
APP_DEBUG=false
APP_URL=https://API.DOMAIN-ANDA.ID
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ecowin
DB_USERNAME=ecowin
DB_PASSWORD=ISI_SANDI_DATABASE

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BCRYPT_ROUNDS=12

# Login Google (client "Web application"; lihat DEPLOY.md bagian 2)
GOOGLE_CLIENT_ID=ISI_CLIENT_ID
GOOGLE_CLIENT_SECRET=ISI_CLIENT_SECRET
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
GOOGLE_EXTRA_CLIENT_IDS=

AUTH_REMEMBER_MINUTES=43200
ECOWIN_ACCESS_TOKEN_TTL=1440
ECOWIN_REFRESH_TOKEN_TTL=86400
ECOWIN_KOMPOS_RASIO=0.5
ECOWIN_BIOPORI_HARI_PANEN=60

# Alamat web nasabah (tanpa garis miring di akhir)
ECOWIN_WEB_ORIGINS=https://WEB.DOMAIN-ANDA.ID
ECOWIN_WEB_URL=https://WEB.DOMAIN-ANDA.ID

# Notifikasi Firebase (opsional; lihat FIREBASE.md). Berkas JSON disalin sendiri ke server, di luar folder public.
FIREBASE_CREDENTIALS=/var/www/ecowin/backend/storage/app/firebase/akun-layanan.json
